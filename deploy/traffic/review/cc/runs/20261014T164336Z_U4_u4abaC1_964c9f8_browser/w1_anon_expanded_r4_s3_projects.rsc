10:["$","$L13",null,{"username":"taeklim","nodes":[{"type":"category","id":"368565571240857600","parent_id":null,"group_id":"368580261668982784","level":0,"priority":50,"title":"projects","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000050.000056","sort_key":"1"},{"type":"category","id":"368565576462766080","parent_id":"368565571240857600","group_id":"368565571240857600","level":1,"priority":100,"title":"cnn-from-scratch","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000050.000056.000100.000057","sort_key":"2"},{"type":"post","id":"368579842431520768","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":0,"title":"Training a CNN From Scratch: 4% to 93.2% on 100 Classes Under a 5M-Parameter Budget","post_id":"368579842431520768","slug":"training-a-cnn-from-scratch-4-to-93-2-on-100-classes-under-a-5m-parameter-budget","description":"Small CNNs trained from scratch, from a 4% starter to 93.2% private accuracy on 100 classes under a 5M-parameter budget.","created_at":"2026-10-14T02:04:41.041Z","updated_at":"2026-10-14T02:04:41.041Z","username":"taeklim","path":"000050.000056.000100.000057.000000.000283","sort_key":"3"},{"type":"post","id":"368579915047505920","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":1,"title":"CNN From Scratch (1/7): A 2.3M-Parameter CNN Reaches 96.5% on EuroSAT","post_id":"368579915047505920","slug":"cnn-from-scratch-1-7-a-2-3m-parameter-cnn-reaches-96-5-on-eurosat","description":"Round 1 of a from-scratch CNN project. A 2.3M-parameter VGG-style CNN classifies 10 EuroSAT land-cover classes at 96.5% private accuracy.","created_at":"2026-10-14T02:04:58.632Z","updated_at":"2026-10-14T02:04:58.632Z","username":"taeklim","path":"000050.000056.000100.000057.000001.000284","sort_key":"4"},{"type":"post","id":"368579978633154560","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":2,"title":"CNN From Scratch (2/7): The Round 1 Recipe Drops From 97.6% to 84.7% on 100 Classes","post_id":"368579978633154560","slug":"cnn-from-scratch-2-7-the-round-1-recipe-drops-from-97-6-to-84-7-on-100-classes","description":"Moving a CNN recipe from 10 to 100 classes. Val falls from 97.6% to 84.7%, and the train-val gap grows from 2.3 pt to 14.8 pt.","created_at":"2026-10-14T02:05:13.834Z","updated_at":"2026-10-14T02:05:13.834Z","username":"taeklim","path":"000050.000056.000100.000057.000002.000285","sort_key":"5"},{"type":"post","id":"368580035805712384","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":3,"title":"CNN From Scratch (3/7): Nine Regularizers, None Beat the Noise","post_id":"368580035805712384","slug":"cnn-from-scratch-3-7-nine-regularizers-none-beat-the-noise","description":"Nine regularizers on a 100-class CNN, each judged against a Â±2 pt noise band from a 1,600-image validation set.","created_at":"2026-10-14T02:05:27.450Z","updated_at":"2026-10-14T02:05:27.450Z","username":"taeklim","path":"000050.000056.000100.000057.000003.000286","sort_key":"6"},{"type":"post","id":"368580091132776448","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":4,"title":"CNN From Scratch (4/7): Epochs, Resolution, Width and SAM","post_id":"368580091132776448","slug":"cnn-from-scratch-4-7-epochs-resolution-width-and-sam","description":"Which scaling levers move a 100-class CNN? Epochs to about 500 and 64 px resolution do. SAM stays inside the noise.","created_at":"2026-10-14T02:05:40.713Z","updated_at":"2026-10-14T02:05:40.713Z","username":"taeklim","path":"000050.000056.000100.000057.000004.000287","sort_key":"7"},{"type":"post","id":"368580148808650752","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":5,"title":"CNN From Scratch (5/7): ResNet Beat VGG by 4.5 Points on 6,400 Training Images","post_id":"368580148808650752","slug":"cnn-from-scratch-5-7-resnet-beat-vgg-by-4-5-points-on-6-400-training-images","description":"VGG, ResNet-18h and WRN-16-4 trained with the same recipe on 6,400 images. ResNet-18h wins by 4.5 pt, and no single change explains why it beats WRN.","created_at":"2026-10-14T02:05:54.406Z","updated_at":"2026-10-14T02:05:54.406Z","username":"taeklim","path":"000050.000056.000100.000057.000005.000288","sort_key":"8"},{"type":"post","id":"368580208741060608","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":6,"title":"CNN From Scratch (6/7): Ensembles, Distillation, and a 94.9% That Became 93.2%","post_id":"368580208741060608","slug":"cnn-from-scratch-6-7-ensembles-distillation-and-a-94-9-that-became-93-2","description":"Distilling a 2-model ensemble into one network, and measuring how much picking the winner on validation inflates its score.","created_at":"2026-10-14T02:06:08.699Z","updated_at":"2026-10-14T02:06:08.699Z","username":"taeklim","path":"000050.000056.000100.000057.000006.000289","sort_key":"9"},{"type":"post","id":"368580271928250368","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":7,"title":"CNN From Scratch (7/7): 139 Runs in 4 Days, With the Rules Written First","post_id":"368580271928250368","slug":"cnn-from-scratch-7-7-139-runs-in-4-days-with-the-rules-written-first","description":"How a one-person project ran 139 single-model runs in four days and kept the results honest with pre-written rules and a run ledger.","created_at":"2026-10-14T02:06:23.765Z","updated_at":"2026-10-14T02:06:23.765Z","username":"taeklim","path":"000050.000056.000100.000057.000007.000290","sort_key":"10"}],"bare":true}]
