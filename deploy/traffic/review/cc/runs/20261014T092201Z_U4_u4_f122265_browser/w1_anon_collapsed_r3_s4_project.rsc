8.632Z","updated_at":"2026-10-14T02:04:58.632Z"},{"id":"368579978633154560","slug":"cnn-from-scratch-2-7-the-round-1-recipe-drops-from-97-6-to-84-7-on-100-classes","title":"CNN From Scratch (2/7): The Round 1 Recipe Drops From 97.6% to 84.7% on 100 Classes","description":"Moving a CNN recipe from 10 to 100 classes. Val falls from 97.6% to 84.7%, and the train-val gap grows from 2.3 pt to 14.8 pt.","priority":2,"seq":"285","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-2-7-the-round-1-recipe-drops-from-97-6-to-84-7-on-100-classes/cnn-from-scratch-2-7-the-round-1-recipe-drops-from-97-6-to-84-7-on-100-classes.webp","status":"public","created_at":"2026-10-14T02:05:13.834Z","updated_at":"2026-10-14T02:05:13.834Z"},{"id":"368580035805712384","slug":"cnn-from-scratch-3-7-nine-regularizers-none-beat-the-noise","title":"CNN From Scratch (3/7): Nine Regularizers, None Beat the Noise","description":"Nine regularizers on a 100-class CNN, each judged against a Â±2 pt noise band from a 1,600-image validation set.","priority":3,"seq":"286","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-3-7-nine-regularizers-none-beat-the-noise/cnn-from-scratch-3-7-nine-regularizers-none-beat-the-noise.webp","status":"public","created_at":"2026-10-14T02:05:27.450Z","updated_at":"2026-10-14T02:05:27.450Z"},{"id":"368580091132776448","slug":"cnn-from-scratch-4-7-epochs-resolution-width-and-sam","title":"CNN From Scratch (4/7): Epochs, Resolution, Width and SAM","description":"Which scaling levers move a 100-class CNN? Epochs to about 500 and 64 px resolution do. SAM stays inside the noise.","priority":4,"seq":"287","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-4-7-epochs-resolution-width-and-sam/cnn-from-scratch-4-7-epochs-resolution-width-and-sam.webp","status":"public","created_at":"2026-10-14T02:05:40.713Z","updated_at":"2026-10-14T02:05:40.713Z"},{"id":"368580148808650752","slug":"cnn-from-scratch-5-7-resnet-beat-vgg-by-4-5-points-on-6-400-training-images","title":"CNN From Scratch (5/7): ResNet Beat VGG by 4.5 Points on 6,400 Training Images","description":"VGG, ResNet-18h and WRN-16-4 trained with the same recipe on 6,400 images. ResNet-18h wins by 4.5 pt, and no single change explains why it beats WRN.","priority":5,"seq":"288","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-5-7-resnet-beat-vgg-by-4-5-points-on-6-400-training-images/cnn-from-scratch-5-7-resnet-beat-vgg-by-4-5-points-on-6-400-training-images.webp","status":"public","created_at":"2026-10-14T02:05:54.406Z","updated_at":"2026-10-14T02:05:54.406Z"},{"id":"368580208741060608","slug":"cnn-from-scratch-6-7-ensembles-distillation-and-a-94-9-that-became-93-2","title":"CNN From Scratch (6/7): Ensembles, Distillation, and a 94.9% That Became 93.2%","description":"Distilling a 2-model ensemble into one network, and measuring how much picking the winner on validation inflates its score.","priority":6,"seq":"289","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-6-7-ensembles-distillation-and-a-94-9-that-became-93-2/cnn-from-scratch-6-7-ensembles-distillation-and-a-94-9-that-became-93-2.webp","status":"public","created_at":"2026-10-14T02:06:08.699Z","updated_at":"2026-10-14T02:06:08.699Z"},{"id":"368580271928250368","slug":"cnn-from-scratch-7-7-139-runs-in-4-days-with-the-rules-written-first","title":"CNN From Scratch (7/7): 139 Runs in 4 Days, With the Rules Written First","description":"How a one-person project ran 139 single-model runs in four days and kept the results honest with pre-written rules and a run ledger.","priority":7,"seq":"290","stored_uri":"https://blog-assets.prettylog.com/1/projects/cnn-from-scratch/cnn-from-scratch-7-7-139-runs-in-4-days-with-the-rules-written-first/cnn-from-scratch-7-7-139-runs-in-4-days-with-the-rules-written-first.webp","status":"public","created_at":"2026-10-14T02:06:23.765Z","updated_at":"2026-10-14T02:06:23.765Z"}]}]]}]
