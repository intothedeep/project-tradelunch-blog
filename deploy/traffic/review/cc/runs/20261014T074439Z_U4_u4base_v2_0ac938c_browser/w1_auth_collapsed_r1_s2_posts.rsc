d:["$","$L14",null,{"categories":[{"type":"category","id":"368565571240857600","parent_id":null,"group_id":"368580261668982784","level":0,"priority":50,"title":"projects","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000050.000056","sort_key":"1"},{"type":"category","id":"368565576462766080","parent_id":"368565571240857600","group_id":"368565571240857600","level":1,"priority":100,"title":"cnn-from-scratch","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000050.000056.000100.000057","sort_key":"2"},{"type":"post","id":"368579842431520768","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":0,"title":"Training a CNN From Scratch: 4% to 93.2% on 100 Classes Under a 5M-Parameter Budget","post_id":"368579842431520768","slug":"training-a-cnn-from-scratch-4-to-93-2-on-100-classes-under-a-5m-parameter-budget","description":"Small CNNs trained from scratch, from a 4% starter to 93.2% private accuracy on 100 classes under a 5M-parameter budget.","created_at":"2026-10-14T02:04:41.041Z","updated_at":"2026-10-14T02:04:41.041Z","username":"taeklim","path":"000050.000056.000100.000057.000000.000283","sort_key":"3"},{"type":"post","id":"368579915047505920","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":1,"title":"CNN From Scratch (1/7): A 2.3M-Parameter CNN Reaches 96.5% on EuroSAT","post_id":"368579915047505920","slug":"cnn-from-scratch-1-7-a-2-3m-parameter-cnn-reaches-96-5-on-eurosat","description":"Round 1 of a from-scratch CNN project. A 2.3M-parameter VGG-style CNN classifies 10 EuroSAT land-cover classes at 96.5% private accuracy.","created_at":"2026-10-14T02:04:58.632Z","updated_at":"2026-10-14T02:04:58.632Z","username":"taeklim","path":"000050.000056.000100.000057.000001.000284","sort_key":"4"},{"type":"post","id":"368579978633154560","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":2,"title":"CNN From Scratch (2/7): The Round 1 Recipe Drops From 97.6% to 84.7% on 100 Classes","post_id":"368579978633154560","slug":"cnn-from-scratch-2-7-the-round-1-recipe-drops-from-97-6-to-84-7-on-100-classes","description":"Moving a CNN recipe from 10 to 100 classes. Val falls from 97.6% to 84.7%, and the train-val gap grows from 2.3 pt to 14.8 pt.","created_at":"2026-10-14T02:05:13.834Z","updated_at":"2026-10-14T02:05:13.834Z","username":"taeklim","path":"000050.000056.000100.000057.000002.000285","sort_key":"5"},{"type":"post","id":"368580035805712384","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":3,"title":"CNN From Scratch (3/7): Nine Regularizers, None Beat the Noise","post_id":"368580035805712384","slug":"cnn-from-scratch-3-7-nine-regularizers-none-beat-the-noise","description":"Nine regularizers on a 100-class CNN, each judged against a Â±2 pt noise band from a 1,600-image validation set.","created_at":"2026-10-14T02:05:27.450Z","updated_at":"2026-10-14T02:05:27.450Z","username":"taeklim","path":"000050.000056.000100.000057.000003.000286","sort_key":"6"},{"type":"post","id":"368580091132776448","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":4,"title":"CNN From Scratch (4/7): Epochs, Resolution, Width and SAM","post_id":"368580091132776448","slug":"cnn-from-scratch-4-7-epochs-resolution-width-and-sam","description":"Which scaling levers move a 100-class CNN? Epochs to about 500 and 64 px resolution do. SAM stays inside the noise.","created_at":"2026-10-14T02:05:40.713Z","updated_at":"2026-10-14T02:05:40.713Z","username":"taeklim","path":"000050.000056.000100.000057.000004.000287","sort_key":"7"},{"type":"post","id":"368580148808650752","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":5,"title":"CNN From Scratch (5/7): ResNet Beat VGG by 4.5 Points on 6,400 Training Images","post_id":"368580148808650752","slug":"cnn-from-scratch-5-7-resnet-beat-vgg-by-4-5-points-on-6-400-training-images","description":"VGG, ResNet-18h and WRN-16-4 trained with the same recipe on 6,400 images. ResNet-18h wins by 4.5 pt, and no single change explains why it beats WRN.","created_at":"2026-10-14T02:05:54.406Z","updated_at":"2026-10-14T02:05:54.406Z","username":"taeklim","path":"000050.000056.000100.000057.000005.000288","sort_key":"8"},{"type":"post","id":"368580208741060608","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":6,"title":"CNN From Scratch (6/7): Ensembles, Distillation, and a 94.9% That Became 93.2%","post_id":"368580208741060608","slug":"cnn-from-scratch-6-7-ensembles-distillation-and-a-94-9-that-became-93-2","description":"Distilling a 2-model ensemble into one network, and measuring how much picking the winner on validation inflates its score.","created_at":"2026-10-14T02:06:08.699Z","updated_at":"2026-10-14T02:06:08.699Z","username":"taeklim","path":"000050.000056.000100.000057.000006.000289","sort_key":"9"},{"type":"post","id":"368580271928250368","parent_id":"368565576462766080","group_id":"368565571240857600","level":2,"priority":7,"title":"CNN From Scratch (7/7): 139 Runs in 4 Days, With the Rules Written First","post_id":"368580271928250368","slug":"cnn-from-scratch-7-7-139-runs-in-4-days-with-the-rules-written-first","description":"How a one-person project ran 139 single-model runs in four days and kept the results honest with pre-written rules and a run ledger.","created_at":"2026-10-14T02:06:23.765Z","updated_at":"2026-10-14T02:06:23.765Z","username":"taeklim","path":"000050.000056.000100.000057.000007.000290","sort_key":"10"},{"type":"category","id":"333812802982514688","parent_id":null,"group_id":"334900323220983808","level":0,"priority":100,"title":"technology","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000001","sort_key":"11"},{"type":"category","id":"333812808527384576","parent_id":"333812802982514688","group_id":"333812802982514688","level":1,"priority":100,"title":"ai","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000001.000100.000002","sort_key":"12"},{"type":"post","id":"333813632661983232","parent_id":"333812808527384576","group_id":"333812802982514688","level":2,"priority":100,"title":"Complete Guide to LangChain for Beginners","post_id":"333813632661983232","slug":"complete-guide-to-langchain-for-beginners","description":"A comprehensive beginner's guide to LangChain framework for building LLM applications. Covers chains, agents, memory systems, and RAG with practical examples.","created_at":"2026-07-10T03:36:11.664Z","updated_at":"2026-07-10T03:36:11.664Z","username":"taeklim","path":"000100.000001.000100.000002.000100.000006","sort_key":"13"},{"type":"category","id":"334900230858215424","parent_id":"333812808527384576","group_id":"333812802982514688","level":2,"priority":100,"title":"machine-learning","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000001.000100.000002.000100.000040","sort_key":"14"},{"type":"category","id":"333813561828577280","parent_id":null,"group_id":"333821149437759488","level":0,"priority":100,"title":"rust","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000004","sort_key":"15"},{"type":"post","id":"333821154840023040","parent_id":"333813561828577280","group_id":"333821149437759488","level":1,"priority":100,"title":"Rust Config","post_id":"333821154840023040","slug":"rust-config","description":"Install and manage Rust toolchains with rustup on macOS â€” pin per-project versions, add components like clippy and rustfmt, and set up cross-compilation targets for Linux, WASM, and iOS.","created_at":"2026-07-10T04:06:05.192Z","updated_at":"2026-07-10T04:06:05.192Z","username":"taeklim","path":"000100.000004.000100.000018","sort_key":"16"},{"type":"category","id":"333813581298536448","parent_id":null,"group_id":"333813581298536448","level":0,"priority":100,"title":"finance","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000005","sort_key":"17"},{"type":"category","id":"333813586457530368","parent_id":"333813581298536448","group_id":"333813581298536448","level":1,"priority":100,"title":"research","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000005.000100.000006","sort_key":"18"},{"type":"post","id":"333813587443191808","parent_id":"333813586457530368","group_id":"333813581298536448","level":2,"priority":100,"title":"Do Politicians Beat the Market? Building an Event-Study Harness to Find Out","post_id":"333813587443191808","slug":"do-politicians-beat-the-market-building-an-event-study-harness-to-find-out","description":"I built an event-study / cumulative-abnormal-return harness to test whether U.S. congressional trading disclosures actually predict forward stock returns. Raw returns looked spectacular (t=5.8). But once I subtracted the sector's own return, the politician \"signal\" evaporated to t=0.7 â€” it was market beta, not skill. The one signal that survived sector-neutralization was institutional 13F new positions (+1.88% over 21 days, t=3.15). This is the story of why sector-neutral benchmarking is not optional, and how a hardcoded scoring weight can fool you.","created_at":"2026-07-10T03:36:00.910Z","updated_at":"2026-07-10T03:36:00.910Z","username":"taeklim","path":"000100.000005.000100.000006.000100.000004","sort_key":"19"},{"type":"category","id":"333813605940072448","parent_id":null,"group_id":"333813605940072448","level":0,"priority":100,"title":"java","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000007","sort_key":"20"},{"type":"category","id":"333813610042101760","parent_id":"333813605940072448","group_id":"333813605940072448","level":1,"priority":100,"title":"spring","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000007.000100.000008","sort_key":"21"},{"type":"category","id":"333813610440560640","parent_id":"333813610042101760","group_id":"333813605940072448","level":2,"priority":100,"title":"jdbc","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000007.000100.000008.000100.000009","sort_key":"22"},{"type":"post","id":"333813611459776512","parent_id":"333813610440560640","group_id":"333813605940072448","level":3,"priority":100,"title":"java spring jdbc","post_id":"333813611459776512","slug":"java-spring-jdbc","description":"A practical guide to three Spring Boot JDBC starters â€” spring-session-jdbc, spring-boot-starter-data-jdbc, and spring-boot-starter-jdbc â€” and when to use each for sessions, CRUD, and raw SQL.","created_at":"2026-07-10T03:36:06.525Z","updated_at":"2026-07-10T03:36:06.525Z","username":"taeklim","path":"000100.000007.000100.000008.000100.000009.000100.000005","sort_key":"23"},{"type":"category","id":"333813651154669568","parent_id":null,"group_id":"334178327247982592","level":0,"priority":100,"title":"web","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000012","sort_key":"24"},{"type":"category","id":"333813656452075520","parent_id":"333813651154669568","group_id":"333813651154669568","level":1,"priority":100,"title":"cache","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000012.000100.000013","sort_key":"25"},{"type":"post","id":"333813657571954688","parent_id":"333813656452075520","group_id":"333813651154669568","level":2,"priority":100,"title":"Bots, robots.txt, and ISR: How I Cut Supabase Egress 6Ã—","post_id":"333813657571954688","slug":"bots-robots-txt-and-isr-how-i-cut-supabase-egress-6","description":"My Supabase egress blew past the 5GB free tier to ~30GB in two days â€” and it stayed high even on days I never opened the app. That last detail was the whole clue: the traffic was automated. This is how I traced it to crawler-amplified, uncached SSR reads, and the three-layer fix â€” de-indexing, a User-Agent bot filter at both the edge and the API, and Next.js ISR caching â€” that keeps the pages public for humans while making bot and repeat traffic essentially free.","created_at":"2026-07-10T03:36:17.579Z","updated_at":"2026-07-10T03:36:17.579Z","username":"taeklim","path":"000100.000012.000100.000013.000100.000007","sort_key":"26"},{"type":"category","id":"333813685589905408","parent_id":"333813651154669568","group_id":"333813651154669568","level":1,"priority":100,"title":"how-to-build-quick-app","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000012.000100.000015","sort_key":"27"},{"type":"post","id":"333813686755921920","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":0,"title":"The Modern SaaS Starter Stack: Vercel, Clerk, Supabase, Stripe & GitHub Actions","post_id":"333813686755921920","slug":"the-modern-saas-starter-stack-vercel-clerk-supabase-stripe-github-actions","description":"A practical, end-to-end guide to standing up a production SaaS on Vercel, Clerk, Supabase, Stripe, and GitHub Actions. The overview post that ties the five setup guides together.","created_at":"2026-07-10T03:36:24.529Z","updated_at":"2026-07-10T03:36:24.529Z","username":"taeklim","path":"000100.000012.000100.000015.000000.000008","sort_key":"28"},{"type":"post","id":"333813715822448640","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":1,"title":"Deploy a Next.js App on Vercel: A Step-by-Step Setup","post_id":"333813715822448640","slug":"deploy-a-next-js-app-on-vercel-a-step-by-step-setup","description":"Connect a GitHub repo to Vercel, configure environment variables, and ship a Next.js app with Git-based production and preview deployments. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:31.465Z","updated_at":"2026-07-10T03:36:31.465Z","username":"taeklim","path":"000100.000012.000100.000015.000001.000009","sort_key":"29"},{"type":"post","id":"333813738215837696","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":2,"title":"Set Up a Postgres Database with Supabase","post_id":"333813738215837696","slug":"set-up-a-postgres-database-with-supabase","description":"Create a Supabase project, run SQL migrations with the CLI, query from Next.js, and lock data down with row-level security. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:36.763Z","updated_at":"2026-07-10T03:36:36.763Z","username":"taeklim","path":"000100.000012.000100.000015.000002.000010","sort_key":"30"},{"type":"post","id":"333813759971692544","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":3,"title":"Add Authentication to Next.js with Clerk","post_id":"333813759971692544","slug":"add-authentication-to-next-js-with-clerk","description":"Wire up drop-in authentication in a Next.js App Router project with Clerk â€” provider, middleware, protected routes, and reading the current user on server and client. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:42.006Z","updated_at":"2026-07-10T03:36:42.006Z","username":"taeklim","path":"000100.000012.000100.000015.000003.000011","sort_key":"31"},{"type":"post","id":"333813780867715072","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":4,"title":"Accept Payments in Next.js with Stripe","post_id":"333813780867715072","slug":"accept-payments-in-next-js-with-stripe","description":"Add Stripe Checkout, subscriptions, and a webhook handler to a Next.js app â€” with the CLI for local webhook testing. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:46.978Z","updated_at":"2026-07-10T03:36:46.978Z","username":"taeklim","path":"000100.000012.000100.000015.000004.000012","sort_key":"32"},{"type":"post","id":"333813802602598400","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":5,"title":"CI/CD for Next.js with GitHub Actions","post_id":"333813802602598400","slug":"ci-cd-for-next-js-with-github-actions","description":"Build a GitHub Actions pipeline that lints, type-checks, and tests every push, then deploys to Vercel on green. Includes caching, secrets, and matrix builds. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:52.180Z","updated_at":"2026-07-10T03:36:52.180Z","username":"taeklim","path":"000100.000012.000100.000015.000005.000013","sort_key":"33"},{"type":"post","id":"333813824853381120","parent_id":"333813685589905408","group_id":"333813651154669568","level":2,"priority":6,"title":"Next.js Data Fetching: Route Handlers vs Server Actions","post_id":"333813824853381120","slug":"next-js-data-fetching-route-handlers-vs-server-actions","description":"The three data-fetching layers in a Next.js App Router app â€” core fetchers, Server Actions, and Route Handlers â€” with a concrete infinite-scroll example and a clear rule for when to use each. Part of the SaaS starter stack series.","created_at":"2026-07-10T03:36:57.481Z","updated_at":"2026-07-10T03:36:57.481Z","username":"taeklim","path":"000100.000012.000100.000015.000006.000014","sort_key":"34"},{"type":"category","id":"333813845699072000","parent_id":"333813651154669568","group_id":"333813651154669568","level":1,"priority":100,"title":"seo","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000012.000100.000029","sort_key":"35"},{"type":"post","id":"333813846886060032","parent_id":"333813845699072000","group_id":"333813651154669568","level":2,"priority":0,"title":"SEO for a Next.js 16 App: Metadata, JSON-LD, Sitemaps & Programmatic Pages","post_id":"333813846886060032","slug":"seo-for-a-next-js-16-app-metadata-json-ld-sitemaps-programmatic-pages","description":"A practical, code-first guide to search engine optimization on Next.js 16 App Router â€” the Metadata API, per-page generateMetadata, JSON-LD structured data, sitemap.ts / robots.ts, canonical URLs, soft-404 fixes, and programmatic SEO for thousands of data pages.","created_at":"2026-07-10T03:37:02.698Z","updated_at":"2026-07-10T03:37:02.698Z","username":"taeklim","path":"000100.000012.000100.000029.000000.000015","sort_key":"36"},{"type":"category","id":"334170712988192768","parent_id":"333813651154669568","group_id":"333813651154669568","level":1,"priority":100,"title":"auth-architecture","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000012.000100.000035","sort_key":"37"},{"type":"post","id":"334178333317140480","parent_id":"334170712988192768","group_id":"333813651154669568","level":2,"priority":100,"title":"How Clerk Auth Actually Works: The Mental Model Behind Next.js SSR + a Separate Express API","post_id":"334178333317140480","slug":"how-clerk-auth-actually-works-the-mental-model-behind-next-js-ssr-a-separate-express-api","description":"The mental model behind Clerk auth in a Next.js SSR + Express + Supabase stack â€” what the session token really is, authN vs authZ, the step-by-step sign-in flow, and why the token gets verified twice on its way to your data.","created_at":"2026-07-11T03:45:22.999Z","updated_at":"2026-07-11T03:45:22.999Z","username":"taeklim","path":"000100.000012.000100.000035.000100.000021","sort_key":"38"},{"type":"category","id":"333818772701843456","parent_id":null,"group_id":"333821068647075840","level":0,"priority":100,"title":"dsa","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000030","sort_key":"39"},{"type":"post","id":"333821074493935616","parent_id":"333818772701843456","group_id":"333821068647075840","level":1,"priority":100,"title":"when to mark visited","post_id":"333821074493935616","slug":"when-to-mark-visited","description":"The meaning of visited depends on the algorithmâ€™s correctness guarantee. In BFS and DFS, visited means the node is discovered or entered, so it must be marked immediately to prevent duplicate work and cycles. In Dijkstra, visited means the nodeâ€™s shortest distance is finalized, which only becomes true when the node is extracted as the minimum from the priority queue. The difference comes from edge weights and optimality requirements, not traversal style.","created_at":"2026-07-10T04:05:46.114Z","updated_at":"2026-07-10T04:05:46.114Z","username":"taeklim","path":"000100.000030.000100.000017","sort_key":"40"},{"type":"category","id":"333823725176623104","parent_id":null,"group_id":"333823725176623104","level":0,"priority":100,"title":"linux","post_id":null,"slug":null,"description":null,"created_at":null,"updated_at":null,"username":"taeklim","path":"000100.000033","sort_key":"41"},{"type":"post","id":"333823730369171456","parent_id":"333823725176623104","group_id":"333823725176623104","level":1,"priority":100,"title":"Linux Commands","post_id":"333823730369171456","slug":"linux-commands","description":"A running collection of Linux commands I actually use or looked up â€” starting with memory inspection and process monitoring, each with a short comment on what it does.","created_at":"2026-07-10T04:16:19.341Z","updated_at":"2026-07-10T04:16:19.341Z","username":"taeklim","path":"000100.000033.000100.000019","sort_key":"42"}],"mode":"filter","bare":true,"filterBasePath":"$undefined","className":"$undefined"}]
